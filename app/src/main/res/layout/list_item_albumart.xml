<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
	 android:orientation="horizontal"
	 android:layout_width="match_parent"
	 android:layout_height="wrap_content">

	<ImageView
		android:id="@+id/list_item_albumart_image"
		android:layout_width="@dimen/item_albumart_image_size"
		android:layout_height="@dimen/item_albumart_image_size"
		android:layout_margin="@dimen/item_albumart_item_margins" />

	<LinearLayout
		android:layout_width="0dp"
		android:layout_height="wrap_content"
		android:layout_weight="1"
		android:orientation="vertical">

		<TextView
			android:id="@+id/list_item_albumart_title"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_margin="@dimen/item_albumart_item_margins"/>

		<TextView
			android:id="@+id/list_item_albumart_artist"
			android:layout_width="match_parent"
			android:layout_height="wrap_content"
			android:layout_margin="@dimen/item_albumart_item_margins"/>
	</LinearLayout>

</LinearLayout>