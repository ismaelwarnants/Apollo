<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:padding="@dimen/list_preferred_item_padding">

	<TextView
		android:id="@+id/grid_base_empty_info"
		android:layout_width="wrap_content"
		android:layout_height="wrap_content"
		android:visibility="gone"
		android:paddingStart="@dimen/list_empty_text_padding"
		android:paddingEnd="@dimen/list_empty_text_padding"
		android:layout_gravity="center"
		android:text="@string/empty_music" />

	<GridView
		android:id="@+id/grid_base"
		android:layout_width="match_parent"
		android:layout_height="match_parent"
		android:cacheColorHint="@android:color/transparent"
		android:drawSelectorOnTop="true"
		android:horizontalSpacing="@dimen/grid_item_spacing"
		android:scrollbarThumbVertical="@color/scrollbar_thumb_color"
		android:scrollbars="none"
		android:fastScrollEnabled="true"
		android:verticalSpacing="@dimen/grid_item_spacing" />

</FrameLayout>